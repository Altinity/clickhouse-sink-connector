{% set sink_connector_version = item.systemd.sink_connector_version | default('') %}
# README: This configuration file is generated by Ansible.
# It configures the ClickHouse Sink Connector (lightweight / embedded Debezium)
# for MySQL -> ClickHouse replication.
# Do not edit this file directly; modify the Ansible inventory instead.
# Deployment Name: {{ item.name }}
# Sink Connector Version: {{ sink_connector_version if sink_connector_version != '' else 'Not specified — set systemd.sink_connector_version in inventory' }}

# The unique name of the connector.
name: "{{ item.sink_connector_name | default(item.mysql.host ~ '--' ~ item.mysql.database ~ '___' ~ item.clickhouse.host ~ '___' ~ item.name) }}"

cli.port: "{{ item.sink_connector.cli_port | default(7000) }}"
metrics.port: "{{ item.sink_connector.metrics_port | default(8083) }}"

# MySQL server hostname or IP.
database.hostname: "{{ item.mysql.host }}"

# MySQL server port number.
database.port: "{{ item.mysql.port }}"

# Username for connecting to the MySQL database.
database.user: "{{ item.mysql.user }}"

# Password for connecting to the MySQL database (keep in Ansible Vault or a secrets manager).
database.password: "{{ item.mysql.password }}"

# Unique server ID for the MySQL replication protocol. Must be unique per source.
database.server.id: "{{ item.mysql.server_id }}"

# Logical name for the MySQL server (used internally by the connector).
database.server.name: "{{ item.mysql.server_name }}"

# List of MySQL databases to be monitored.
database.include.list: "{{ item.mysql.database }}"

# Optional list of fully-qualified table names to include in monitoring.
{% if item.mysql.table_include_list is defined %}
table.include.list: "{{ item.mysql.table_include_list }}"
{% endif %}

# Optional list of fully-qualified table names to exclude from monitoring.
{% if item.mysql.table_exclude_list is defined %}
table.exclude.list:  "{{ item.mysql.table_exclude_list }}"
{% endif %}

# Maximum size of packets from the MySQL replication stream.
driver.max_packet_size: 1073741824

# Timezone of the MySQL server for correctly adjusting timestamps.
database.connectionTimeZone: "{{ item.mysql.source_mysql_timezone | default('UTC') }}"

# How binary values should be formatted (default: base64 encoding).
binary.handling.mode: "base64"

# Disables Debezium's time adjustment that remaps 2-digit years into the 1970-2069 range.
# When true (Debezium default), dates like 0001-01-01 are converted to 2001-01-01,
# causing data divergence between MySQL and ClickHouse.
# See: https://github.com/Altinity/clickhouse-sink-connector/issues/470
enable.time.adjuster: "{{ item.sink_connector.enable_time_adjuster | default('false') }}"

# Overrides the default timezone of ClickHouse for datetime columns.
clickhouse.datetime.timezone: "{{ item.clickhouse.timezone | default('UTC') }}"

# ClickHouse server hostname or IP.
clickhouse.server.url: "{{ item.clickhouse.host }}"

# Username for connecting to the ClickHouse server.
clickhouse.server.user: "{{ item.clickhouse.user }}"

# Password for connecting to the ClickHouse server (keep in Ansible Vault or a secrets manager).
clickhouse.server.password: "{{ item.clickhouse.password }}"

# Port number for the ClickHouse server (HTTP interface).
clickhouse.server.port: "{{ item.clickhouse.port }}"

# (Deprecated) Name of the ClickHouse database. Defaults to the source database name.
clickhouse.server.database: "{{ item.clickhouse.database | default('default') }}"

# Optional mapping to override the ClickHouse database name for specific source databases.
{% if item.clickhouse.database_override_map is defined %}
clickhouse.database.override.map: "{{ item.clickhouse.database_override_map }}"
{% endif %}

# ClickHouse JDBC parameters for tuning connection behavior.
clickhouse.jdbc.params: "{{ item.clickhouse.jdbc_params | default('keepalive.timeout=3,max_buffer_size=1000000,socket_timeout=30000,connection_timeout=30000') }}"

# Allows retrieval of public keys (used by MySQL 8+ for secure connections).
database.allowPublicKeyRetrieval: "true"

# SAFETY: 'schema_only' snapshots only the schema, never the data.
# 'initial' would DROP and re-snapshot every replicated table — never
# use it against a target that already has data you care about.
snapshot.mode: "{{ item.sink_connector.snapshot_mode | default('schema_only') }}"

# How often (in milliseconds) the connector flushes offset information.
offset.flush.interval.ms: 5000

# Number of threads in the thread pool for processing records.
thread.pool.size: {{ item.sink_connector.thread_pool_size | default(10) }}

# Maximum number of records per batch.
max.batch.size: {{ item.sink_connector.max_batch_size | default(10000) }}

# Maximum queue size for pending records before flush.
max.queue.size: 100000

# Automatically restarts the CDC event loop if no messages arrive within a timeout period.
{% if item.sink_connector.skip_restart_event_loop is not defined %}
restart.event.loop: "true"

# Timeout period (in seconds) for restarting the CDC event loop.
restart.event.loop.timeout.period.secs: "3000"
{% endif %}

# Connector implementation (Debezium MySQL connector).
connector.class: "io.debezium.connector.mysql.MySqlConnector"

# Offset storage class for storing replication progress in ClickHouse (no Kafka needed).
offset.storage: "io.debezium.storage.jdbc.offset.JdbcOffsetBackingStore"

{% if item.sink_connector.replication_history_enable is defined %}
replication.history.enable: "{{ item.sink_connector.replication_history_enable }}"
{% endif %}
{% if item.sink_connector.replication_history_replication_log_only is defined %}
replication.history.replication_log_only: "{{ item.sink_connector.replication_history_replication_log_only }}"
{% endif %}

# Offset storage table. Property names changed in 2.7.1 — the template
# renders the correct variant based on the declared connector version.
{% if sink_connector_version != '' and sink_connector_version is version("2.7.1", ">=") %}
offset.storage.jdbc.table.name: "{{ item.offset_clickhouse.table_name | default('altinity_sink_connector.replica_source_info') }}"
{% else %}
offset.storage.jdbc.offset.table.name: "{{ item.offset_clickhouse.table_name | default('altinity_sink_connector.replica_source_info') }}"
{% endif %}

# JDBC URL for storing offset information in ClickHouse.
offset.storage.jdbc.url: "{{ item.offset_clickhouse.jdbc_url }}"

# Username for the offset storage connection.
offset.storage.jdbc.user: "{{ item.offset_clickhouse.user }}"

# Password for the offset storage connection.
offset.storage.jdbc.password: "{{ item.offset_clickhouse.password }}"

# DDL statement for creating the offset table.
{% if sink_connector_version != '' and sink_connector_version is version("2.7.1", ">=") %}
offset.storage.jdbc.table.ddl: "CREATE TABLE if not exists %s (`id` String, `offset_key` String, `offset_val` String, `record_insert_ts` DateTime, `record_insert_seq` UInt64, `_version` UInt64 MATERIALIZED toUnixTimestamp64Nano(now64(9))) ENGINE = ReplacingMergeTree(_version) ORDER BY offset_key SETTINGS index_granularity = 8192"
{% else %}
offset.storage.jdbc.offset.table.ddl: "CREATE TABLE if not exists %s (`id` String, `offset_key` String, `offset_val` String, `record_insert_ts` DateTime, `record_insert_seq` UInt64, `_version` UInt64 MATERIALIZED toUnixTimestamp64Nano(now64(9))) ENGINE = ReplacingMergeTree(_version) ORDER BY offset_key SETTINGS index_granularity = 8192"
{% endif %}

# DML used by the connector where a delete would normally run (kept as a no-op SELECT).
{% if sink_connector_version != '' and sink_connector_version is version("2.7.1", ">=") %}
offset.storage.jdbc.table.delete: "select * from %s"
offset.storage.jdbc.table.select: "SELECT id, offset_key, offset_val FROM %s FINAL ORDER BY record_insert_ts, record_insert_seq"
{% else %}
offset.storage.jdbc.offset.table.delete: "select * from %s"
offset.storage.jdbc.offset.table.select: "SELECT id, offset_key, offset_val FROM %s FINAL ORDER BY record_insert_ts, record_insert_seq"
{% endif %}

# Debezium schema history stored in ClickHouse (tracks DDL changes).
schema.history.internal: "io.debezium.storage.jdbc.history.JdbcSchemaHistory"

# JDBC URL for storing schema history in ClickHouse.
schema.history.internal.jdbc.url: "{{ item.schema_history_clickhouse.jdbc_url }}"

# Username for the schema history connection.
schema.history.internal.jdbc.user: "{{ item.schema_history_clickhouse.user }}"

# Password for the schema history connection.
schema.history.internal.jdbc.password: "{{ item.schema_history_clickhouse.password }}"

# DDL statement for creating the schema history table.
{% if sink_connector_version != '' and sink_connector_version is version("2.7.1", ">=") %}
schema.history.internal.jdbc.table.ddl: "CREATE TABLE if not exists %s (`id` VARCHAR(36) NOT NULL, `history_data` VARCHAR(65000), `history_data_seq` INTEGER, `record_insert_ts` TIMESTAMP NOT NULL, `record_insert_seq` INTEGER NOT NULL) ENGINE = ReplacingMergeTree(record_insert_seq) ORDER BY id"
schema.history.internal.jdbc.table.name: "{{ item.schema_history_clickhouse.table_name | default('altinity_sink_connector.replicate_schema_history') }}"
{% else %}
schema.history.internal.jdbc.schema.history.table.ddl: "CREATE TABLE if not exists %s (`id` VARCHAR(36) NOT NULL, `history_data` VARCHAR(65000), `history_data_seq` INTEGER, `record_insert_ts` TIMESTAMP NOT NULL, `record_insert_seq` INTEGER NOT NULL) ENGINE = ReplacingMergeTree(record_insert_seq) ORDER BY id"
schema.history.internal.jdbc.schema.history.table.name: "{{ item.schema_history_clickhouse.table_name | default('altinity_sink_connector.replicate_schema_history') }}"
{% endif %}

# SAFETY: skip DDL that Debezium cannot parse instead of crashing.
# Particularly useful for MySQL 8.0+ functional indexes.
# Caused by: io.debezium.text.ParsingException: DDL statement couldn't be parsed
schema.history.internal.skip.unparseable.ddl: "{{ item.sink_connector.skip_unparseable_ddl | default(sink_connector_skip_unparseable_ddl_default) | lower }}"

# Prevents parsing DDL during snapshots to improve performance.
enable.snapshot.ddl: "false"

# Whether the connector may auto-create target tables in ClickHouse.
auto.create.tables: "{{ item.clickhouse.auto_create_tables | default('false') }}"
{% if item.clickhouse.table_engine is defined %}
clickhouse.table.engine: "{{ item.clickhouse.table_engine }}"
{% endif %}
{% if item.clickhouse.sign_column is defined %}
clickhouse.table.sign.column: "{{ item.clickhouse.sign_column }}"
{% endif %}
{% if item.clickhouse.version_column is defined %}
clickhouse.table.version.column: "{{ item.clickhouse.version_column }}"
{% endif %}
{% if item.sink_connector.ignore_delete is defined %}
ignore.delete: "{{ item.sink_connector.ignore_delete }}"
{% endif %}

# Limit schema history storage to captured tables/databases only (startup optimization).
schema.history.internal.store.only.captured.tables.ddl: "true"
schema.history.internal.store.only.captured.databases.ddl: "true"

# Enables metrics collection for Prometheus/Grafana integration.
metrics.enable: "true"

# Regular expression to ignore certain DDL events.
ignore.ddl.regex: "(?m).*(CREATE DEFINER|SQL SECURITY DEFINER VIEW|ANALYZE PARTITION).*"

# Disables locking during snapshotting operations.
snapshot.locking.mode: "none"

# Enables fast disconnects for improved recovery from errors.
use.nongraceful.disconnect: "true"

# Sends a keepalive message every 30 seconds to maintain the connection.
database.keep.alive.interval.ms: "30000"

# Backoff for database reconnection attempts (initial / max, milliseconds).
database.connection.reconnect.backoff.ms: "1000"
database.connection.reconnect.backoff.max.ms: "10000"

# SSL mode for the MySQL connection. Enable where your environment supports it.
database.ssl.mode: "{{ item.mysql.ssl_mode | default('disabled') }}"

# Disables connection pooling to avoid resource contention.
connection.pool.disable: "true"
