                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              The JUnit BOM MUST be imported here. A <scope>import</scope> BOM
              is only honoured inside <dependencyManagement>; in a plain
              <dependencies> block Maven ignores it, which is where this one
              used to sit. With the import inert, the hardcoded
              junit-platform 1.8.2 pins below won, while junit-jupiter 5.9.1
              requires platform 1.9.1, and the Jupiter engine calls
              EngineDiscoveryRequest#getDiscoveryListener(), which does not
              exist in 1.8.2.

              The result was NOT a build failure. Every test class died during
              DISCOVERY with NoSuchMethodError, surefire reported
              "Tests run: 0", no surefire XML was written, and the CI job went
              green having executed nothing. Importing the BOM here keeps
              jupiter and platform on the single consistent version set it
              defines.
            -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${version.junit}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

