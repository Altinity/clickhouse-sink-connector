    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Third-party notices and license texts ship inside the JAR
                 (META-INF/THIRD_PARTY_NOTICES.md, META-INF/licenses/). -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>THIRD_PARTY_NOTICES.md</include>
                    <include>licenses/**</include>
                </includes>
            </resource>
        </resources>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.6.2</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>../sink-connector/src/main</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-compiler-plugin is declared once (3.11.0, the declaration
                 the build has always used: Maven 3.9 kept the last of duplicate
                 plugin declarations; Maven 3.10 rejects duplicates). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.altinity.clickhouse.debezium.embedded.ClickHouseDebeziumEmbeddedApplication</mainClass>
                                    <manifestEntries>
                                        <!-- The GPL MySQL JDBC driver is not shaded in (see
                                             version.mysql.connector.j). `java -jar` loads it from
                                             these paths, relative to this jar's directory;
                                             a missing entry is ignored by the JVM and
                                             MySqlJdbcDriver.check refuses a MySQL start. -->
                                        <Class-Path>mysql-connector-j.jar lib/mysql-connector-j.jar</Class-Path>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>org/apache/log4j/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${version.checkstyle.plugin}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- Use the ${surefire-plugin.version} property this POM
                     already declares. It was hardcoded to 2.22.0, which ships
                     a JUnit-platform launcher predating
                     EngineDiscoveryRequest#getDiscoveryListener(); with
                     jupiter 5.9.1 that throws NoSuchMethodError for every
                     test class during discovery, yields "Tests run: 0", and
                     still exits BUILD SUCCESS. -->
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>-Xmx4g -Xms2g -XX:+UseG1GC</argLine>
                    <reuseForks>false</reuseForks>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- <forkCount>10</forkCount> -->
                    <!-- <parallel>all</parallel>
                    <threadCount>10</threadCount> -->
                    <properties>
                        <property>
                            <surefire.test.runOrder>filesystem</surefire.test.runOrder>
                            <name>listener</name>
                            <value>com.altinity.clickhouse.debezium.embedded.FailFastListener</value>
                        </property>
                    </properties>
                    <useUnlimitedThreads>true</useUnlimitedThreads>
                    <perCoreThreadCount>true</perCoreThreadCount>
                    <useSystemClassLoader>true</useSystemClassLoader>
                    <runOrder>${surefire.test.runOrder}</runOrder>

                </configuration>
            </plugin>

            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              License compliance gate (doc/licensing.md).

              This replaces org.honton.chas:license-maven-plugin 0.0.6, whose
              "compliance" goal ran in every build and reported nothing while
              the 2.11.0 shaded jar carried MySQL Connector/J (GPL-2.0, 1,127
              entries under com/mysql/), the MariaDB driver (LGPL-2.1, 283
              entries under org/mariadb/) and JUnit 4 (CPL-1.0, 242 entries
              under org/junit/ and junit/): it never failed a build.

              bannedDependencies fails the build when an ASF Category X
              artifact would be shaded into the jar, i.e. reaches the compile
              or runtime scope directly or transitively. Test and provided
              scopes are not shaded and are allowed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-category-x-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>An ASF Category X (GPL/LGPL/AGPL) or test-only artifact would be shaded into this Apache-2.0 jar. Give it test or provided scope, exclude it, or replace it with a permissively licensed package (doc/licensing.md).</message>
                                    <excludes>
                                        <!-- LGPL-2.1 MariaDB Connector/J -->
                                        <exclude>org.mariadb.jdbc:*:*:*:compile</exclude>
                                        <exclude>org.mariadb.jdbc:*:*:*:runtime</exclude>
                                        <!-- GPL-2.0 Connector/J under its pre-8.0.31 coordinates -->
                                        <exclude>mysql:mysql-connector-java:*:*:compile</exclude>
                                        <exclude>mysql:mysql-connector-java:*:*:runtime</exclude>
                                        <!-- JUnit 4 (CPL-1.0) is a test framework, never production code -->
                                        <exclude>junit:junit:*:*:compile</exclude>
                                        <exclude>junit:junit:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Separate execution so -Pbundle-mysql-driver can turn off
                             exactly this ban and nothing else. -->
                        <id>ban-bundled-mysql-driver</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${bundle.mysql.driver}</skip>
                            <rules>
                                <bannedDependencies>
                                    <message>MySQL Connector/J (GPL-2.0 + Universal FOSS Exception) would be shaded into this Apache-2.0 jar. It must stay "provided" and be supplied at run time; only an internal, never-redistributed build may use -Pbundle-mysql-driver (doc/licensing.md).</message>
                                    <excludes>
                                        <exclude>com.mysql:mysql-connector-j:*:*:compile</exclude>
                                        <exclude>com.mysql:mysql-connector-j:*:*:runtime</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copies the run-time-supplied MySQL driver, unmodified and as its
                 own file, to target/mysql-driver/mysql-connector-j.jar, so a
                 deployment or image can place it next to the connector jar
                 (the jar's manifest Class-Path looks there). It is a separate
                 artifact under its own license, not part of the Apache jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-mysql-driver</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.mysql</groupId>
                                    <artifactId>mysql-connector-j</artifactId>
                                    <version>${version.mysql.connector.j}</version>
                                    <destFileName>mysql-connector-j.jar</destFileName>
                                </artifactItem>
                                <!-- The driver's complete corresponding source (GPL-2.0),
                                     shipped next to the binary wherever the binary ships. -->
                                <artifactItem>
                                    <groupId>com.mysql</groupId>
                                    <artifactId>mysql-connector-j</artifactId>
                                    <version>${version.mysql.connector.j}</version>
                                    <classifier>sources</classifier>
                                    <destFileName>mysql-connector-j-${version.mysql.connector.j}-sources.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/mysql-driver</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
          For an INTERNAL build that is never redistributed: shade MySQL
          Connector/J into the jar exactly as releases before the licensing
          change did, so `java -jar` works with no driver jar beside it.
          A jar built this way contains GPL-2.0 code and must not be published
          (doc/licensing.md).
        -->
        <profile>
            <id>bundle-mysql-driver</id>
            <properties>
                <mysql.driver.scope>compile</mysql.driver.scope>
                <bundle.mysql.driver>true</bundle.mysql.driver>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.package.type>native</quarkus.package.type>
            </properties>
            <reporting>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-report-plugin</artifactId>
                        <version>2.22.2</version>
                    </plugin>
                </plugins>
            </reporting>
        </profile>
    </profiles>
</project>