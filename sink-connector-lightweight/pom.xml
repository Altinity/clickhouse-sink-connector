        <!--
          MySQL Connector/J is GPL-2.0 (with the Universal FOSS Exception), an
          ASF Category X license: it must not be bundled into this
          Apache-2.0 jar. It is "provided" by default (on the compile and test
          class path, NOT shaded into the jar) and supplied at run time (see
          MySqlJdbcDriver and doc/licensing.md). The version is the one
          debezium-connector-mysql ${version.debezium} declares.
          -Pbundle-mysql-driver switches the scope to compile for an internal
          build that is never redistributed.
        -->
        <version.mysql.connector.j>9.1.0</version.mysql.connector.j>
        <mysql.driver.scope>provided</mysql.driver.scope>
        <bundle.mysql.driver>false</bundle.mysql.driver>
